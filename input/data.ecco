# ECCO cost function
# ******************
#
 &ECCO_COST_NML
#
 using_cost_seaice = .FALSE.,
 using_cost_sst = .FALSE.,
 using_cost_altim = .FALSE.,
#
 cost_iprec  = 32,
 cost_yftype = 'RL',
#
 /
#
 &ECCO_GENCOST_NML
## MUCH SAFER TO LET STARTDATE = MODELSTARTDATE. Test OK if not using!!
## see "MITgcm_contrib/gael/verification/global_oce_llc90/input.ecco_v4/data.ecco"
## SEA ICE CONCENTRATION -- this is a V4 costfunction and NOT generic
## 2 versions as first sets thing up but second uses SST instead of AREA and is recommended
## this requires NOT changing gencost_name and setting using_cost_seaice
## SeaIce -- this is normal gencost 
 gencost_avgperiod(1)  = 'day',
 gencost_barfile(1) = 'm_siarea',
 gencost_datafile(1) = 'NSIDC_IceConc_v4_GO2202_BG3.bin',
 gencost_errfile(1) = 'SeaIceWeight_BGO3.bin',
 gencost_name(1) = 'siconc',
 gencost_spmin(1) = -999.,
 gencost_spmax(1) = 999.,
 gencost_spzero(1) = -9999.,
 gencost_outputlevel(1)=1,
 mult_gencost(1) = 1.0,
##
## SST -- this is normal gencost 
 gencost_avgperiod(2)  = 'day',
 gencost_barfile(2) = 'm_sst',
 gencost_datafile(2) = 'RSS_OISST_MWfusion_BG3v2.bin',
 gencost_errfile(2) = 'SST_Weight_BGO3_V2.bin',
 gencost_name(2) = 'sst',
 gencost_spmin(2) = -1.8,
 gencost_spmax(2) = 40.,
 gencost_spzero(2) = 0.,
 gencost_outputlevel(2)=1,
 mult_gencost(2) = 1.0000,
##
 gencost_avgperiod(3)  = 'day',
 gencost_barfile(3) = 'm_eta_dyn',
 gencost_datafile(3) = 'aviso_tot_adt_dt_BG3.bin',
 gencost_errfile(3) = 'aviso_wght_adt_dt_BG3.bin',
 gencost_name(3) = 'sshanom',
 gencost_spmin(3) = -5.0,
 gencost_spmax(3) = 5.0,
 gencost_spzero(3) = -9999.,
 gencost_outputlevel(3)=1,
 gencost_preproc(1,3) = 'anom',
 mult_gencost(3) = 100.0,
##
 gencost_avgperiod(4)  = 'day',
 gencost_barfile(4) = 'm_eta_dyn',
 gencost_datafile(4) = 'aviso_tot_adt_dt_BG3.bin',
 gencost_errfile(4) = 'aviso_wght_adt_dt_BG3.bin',
 gencost_name(4) = 'sshbar',
 gencost_spmin(4) = -5.0,
 gencost_spmax(4) = 5.0,
 gencost_spzero(4) = -9999.,
 gencost_outputlevel(4)=1,
 gencost_preproc(1,4) = 'mean',
 mult_gencost(4) = 10000.0,
## MDT SHOULD BE GIVEN IN METERS BUT SSH IN CM!!
