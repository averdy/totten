# SEAICE parameters
# from http://mitgcm.org/viewvc/MITgcm/MITgcm_contrib/llc_hires/llc_270/input_ad/data.seaice
#
 &SEAICE_PARM01
  SEAICEwriteState = .TRUE.,
  SEAICE_no_slip     = .FALSE.,
  SEAICE_clipVelocities = .TRUE.,
# this advection scheme does not work for the adjoint
  SEAICEadvScheme    = 30,
  SEAICE_drag        = 0.002,
  IMAX_TICE = 6,
  SEAICE_salt0       = 4.0,
  LSR_ERROR = 1.e-5,
# just too expensive to have 10 iterations
  SEAICEnonLinIterMax = 2,
#
  SEAICE_waterTurnAngle = 17.0,
  SEAICE_multDim = 7,
  SEAICEpressReplFac = 0.,
#
  SEAICE_strength = 15.0e3,
  SEAICE_cStar    = 15.,
#
  AreaFile  = 'SIarea_BG6_GO2202v4_totten.bin',
  HeffFile  = 'SIheff_BG6_GO2202v4_totten.bin',
#
 /

